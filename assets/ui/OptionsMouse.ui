ssl = <<<
var inited : bool
var mouseSens : float

override OnInit
inited := false
Element("MouseSens").InitVal()
mouseSens := Element("MouseSens").GetVal()
Element("InvertMouse").AddItem("UI_SON", "1")
Element("InvertMouse").AddItem("UI_SOFF", "0")
Element("InvertMouse").InitVal()
Element("MouseCursorThin").AddItem("UI_ADVCTRL_MOUSE_CURSOR_THICK", "0")
Element("MouseCursorThin").AddItem("UI_ADVCTRL_MOUSE_CURSOR_THIN", "1")
Element("MouseCursorThin").InitVal()
Element("LookSensitivity").InitVal()
Element("InvertLookY").AddItem("UI_SON", "1")
Element("InvertLookY").AddItem("UI_SOFF", "0")
Element("InvertLookY").InitVal()
Element("Vibration").AddItem("UI_SON", "1")
Element("Vibration").AddItem("UI_SOFF", "0")
Element("Vibration").InitVal()
Element("DeadZone").InitVal()
Element("GamepadButtons").AddItem("UI_CTRL_buttons_1", "1")
Element("GamepadButtons").AddItem("UI_CTRL_buttons_2", "2")
Element("GamepadButtons").AddItem("UI_CTRL_buttons_3", "3")
Element("GamepadButtons").AddItem("UI_CTRL_buttons_4", "4")
Element("GamepadButtons").InitVal()
Element("GamepadSticks").AddItem("UI_CTRL_thumb_1", "1")
Element("GamepadSticks").AddItem("UI_CTRL_thumb_2", "2")
Element("GamepadSticks").AddItem("UI_CTRL_thumb_3", "3")
Element("GamepadSticks").AddItem("UI_CTRL_thumb_4", "4")
Element("GamepadSticks").InitVal()
Element("ctrl_271").SetText("UI_CTRL_CMD_WPN_NEXT")
Element("ctrl_270").SetText("UI_GP_USE")
Element("ctrl_261").SetText("UI_CTRL_CMD_SHOWFRAGS")
Element("ctrl_260").SetText("UI_CTRL_CMD_UI")
Element("ctrl_263").SetText("UI_CTRL_CMD_NEXT_GRENADE")
Element("ctrl_264").SetText("UI_CTRL_CMD_WPN_PREV")
Element("ctrl_265").SetText("UI_CTRL_CMD_WPN_NEXT")
Element("ctrl_262").SetText("")
Element("page").AddItem("UI_GP_PAGE_CAMERA", "grpCamera")
Element("page").AddItem("UI_GP_PAGE_BUTTONS", "grpButtons")
Element("page").AddItem("UI_GP_PAGE_STICKS", "grpSticks")
Element("page").SetVal("grpCamera")
ShowPage("grpCamera")
inited := true
end

override OnSelectSelection("page")
ShowPage(id)
end

override OnSelectSelection("GamepadButtons")
SetButtons(id)
end

override OnSelectSelection("GamepadSticks")
SetSticks(id)
end

func ShowPage(id : string)
Element("grpCamera").Show(false)
Element("grpButtons").Show(false)
Element("grpSticks").Show(false)
Element("padCtrl").Show(false)
Element(id).Show(true)
if id == "grpButtons"
Element("padCtrl").Show(true)
Element("padImage").SetTexture("gp_pad_spider")
Element("SpiderGroup").Show(true)
Element("LeftUp").Show(false)
Element("LeftLeft").Show(false)
Element("RightDown").Show(false)
Element("RightRight").Show(false)
SetButtons(Element("GamepadButtons").GetVal())
end
if id == "grpSticks"
Element("padCtrl").Show(true)
Element("padImage").SetTexture("gp_pad")
Element("SpiderGroup").Show(false)
Element("LeftUp").Show(true)
Element("LeftLeft").Show(true)
Element("RightDown").Show(true)
Element("RightRight").Show(true)
SetSticks(Element("GamepadSticks").GetVal())
end
end

func SetButtons(id : string)
if id == "1"
Element("ctrl_274").SetText("UI_CTRL_CMD_ATTACK_2")
Element("ctrl_275").SetText("UI_CTRL_CMD_ATTACK_1")
Element("ctrl_272").SetText("UI_GP_TIME")
Element("ctrl_273").SetText("UI_CTRL_CMD_ACTIVATE_GREN_AUTO")
Element("ctrl_268").SetText("UI_CTRL_CMD_JUMP")
Element("ctrl_266").SetText("UI_CTRL_CMD_CROUCH")
Element("ctrl_267").SetText("UI_CTRL_CMD_MINIZOOM")
Element("ctrl_269").SetText("UI_CTRL_CMD_ATTACK_3")
else if id == "2"
Element("ctrl_274").SetText("UI_CTRL_CMD_ATTACK_1")
Element("ctrl_275").SetText("UI_CTRL_CMD_ATTACK_2")
Element("ctrl_272").SetText("UI_CTRL_CMD_ACTIVATE_GREN_AUTO")
Element("ctrl_273").SetText("UI_GP_TIME")
Element("ctrl_268").SetText("UI_CTRL_CMD_CROUCH")
Element("ctrl_266").SetText("UI_CTRL_CMD_MINIZOOM")
Element("ctrl_267").SetText("UI_CTRL_CMD_JUMP")
Element("ctrl_269").SetText("UI_CTRL_CMD_ATTACK_3")
else if id == "3"
Element("ctrl_274").SetText("UI_CTRL_CMD_ATTACK_2")
Element("ctrl_275").SetText("UI_CTRL_CMD_ATTACK_1")
Element("ctrl_272").SetText("UI_GP_TIME")
Element("ctrl_273").SetText("UI_CTRL_CMD_ACTIVATE_GREN_AUTO")
Element("ctrl_268").SetText("UI_CTRL_CMD_JUMP")
Element("ctrl_266").SetText("UI_CTRL_CMD_CROUCH")
Element("ctrl_267").SetText("UI_CTRL_CMD_ATTACK_3")
Element("ctrl_269").SetText("UI_CTRL_CMD_MINIZOOM")
else if id == "4"
Element("ctrl_274").SetText("UI_CTRL_CMD_ATTACK_1")
Element("ctrl_275").SetText("UI_CTRL_CMD_ATTACK_2")
Element("ctrl_272").SetText("UI_CTRL_CMD_ACTIVATE_GREN_AUTO")
Element("ctrl_273").SetText("UI_GP_TIME")
Element("ctrl_268").SetText("UI_CTRL_CMD_CROUCH")
Element("ctrl_266").SetText("UI_CTRL_CMD_ATTACK_3")
Element("ctrl_267").SetText("UI_CTRL_CMD_JUMP")
Element("ctrl_269").SetText("UI_CTRL_CMD_MINIZOOM")
end
end

func SetSticks(id : string)
if id == "1"
Element("LeftUp").SetText("UI_GP_FWDBACK")
Element("LeftLeft").SetText("UI_GP_STRAFE")
Element("RightDown").SetText("UI_GP_LOOKUD")
Element("RightRight").SetText("UI_GP_TURN")
Element("padImage").SetTexture("gp_pad_sticks1")
else if id == "2"
Element("LeftUp").SetText("UI_GP_LOOKUD")
Element("LeftLeft").SetText("UI_GP_TURN")
Element("RightDown").SetText("UI_GP_FWDBACK")
Element("RightRight").SetText("UI_GP_STRAFE")
Element("padImage").SetTexture("gp_pad_sticks2")
else if id == "3"
Element("LeftUp").SetText("UI_GP_FWDBACK")
Element("LeftLeft").SetText("UI_GP_TURN")
Element("RightDown").SetText("UI_GP_LOOKUD")
Element("RightRight").SetText("UI_GP_STRAFE")
Element("padImage").SetTexture("gp_pad_sticks3")
else if id == "4"
Element("LeftUp").SetText("UI_GP_LOOKUD")
Element("LeftLeft").SetText("UI_GP_STRAFE")
Element("RightDown").SetText("UI_GP_FWDBACK")
Element("RightRight").SetText("UI_GP_TURN")
Element("padImage").SetTexture("gp_pad_sticks4")
end
end

override OnUpdate
if inited == true
$ui.SetMouseSens(Element("MouseSens").GetVal(), 10.0, 1.6, false)
end
end

override OnButtonPressed("Restore")
InitRestoreConfirm($ui.ShowFrame("Confirmation"))
end

func InitRestoreConfirm(frm : object)
frm.Element("Message").SetText("UI_MOUSE_DEFAULTS_CONFIRM")
frm.Element("Caption").SetText("UI_DEFAULTS_CONFIRM_CAP")
frm.SetStr("confid", "Restore")
end

override OnButtonPressed("Back")
Element("MouseSens").InitVal()
Element("InvertMouse").InitVal()
Element("MouseCursorThin").InitVal()
Element("LookSensitivity").InitVal()
Element("InvertLookY").InitVal()
Element("Vibration").InitVal()
Element("DeadZone").InitVal()
Element("GamepadButtons").InitVal()
Element("GamepadSticks").InitVal()
$ui.SetMouseSens(mouseSens, 10.0, 1.6, false)
$ui.BackFrame()
end

override OnButtonPressed("Accept")
AcceptValues()
$ui.BackFrame()
end

override OnResult("Restore", "Yes")
SetStr("DefaultChosen", "Yes")
Element("MouseSens").SetVal(0.98)
Element("InvertMouse").SetVal("0")
Element("MouseCursorThin").SetVal("no")
Element("LookSensitivity").SetVal(100.0)
Element("InvertLookY").SetVal("0")
Element("Vibration").SetVal("1")
Element("DeadZone").SetVal(22.0)
Element("GamepadButtons").SetVal("1")
Element("GamepadSticks").SetVal("1")
SetButtons("1")
SetSticks("1")
end

func AcceptValues()
$ui.SetMouseSens(Element("MouseSens").GetVal(), 10.0, 1.6, true)
Element("MouseSens").AcceptVal()
Element("InvertMouse").AcceptVal()
Element("MouseCursorThin").AcceptVal()
Element("LookSensitivity").AcceptVal()
Element("InvertLookY").AcceptVal()
Element("Vibration").AcceptVal()
Element("DeadZone").AcceptVal()
Element("GamepadButtons").AcceptVal()
Element("GamepadSticks").AcceptVal()
$ui.ApplySettings()
$ui.FlushCfg()
end

override OnFocus
Element("Hint").SetText(id)
end
